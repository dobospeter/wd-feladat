                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Error envelope has code \\\"validation_failed\\\"\", () => pm.expect(pm.response.json().error.code).to.eql(\"validation_failed\"));",
                  "pm.test(\"Lists failing fields\", () => pm.expect(pm.response.json().error.details).to.include.keys(\"name\", \"manufacturer\", \"model\"));"
