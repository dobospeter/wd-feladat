APP_NAME="Asset Register"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=asset_register
DB_USERNAME=asset_register
DB_PASSWORD=secret

CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=null

# HTTP Basic credentials protecting the OpenAPI documentation at /docs.
# The documentation stays locked while either value is empty.
DOCS_USERNAME=docs
DOCS_PASSWORD=secret

API_LOG_MAX_BODY_BYTES=65536
